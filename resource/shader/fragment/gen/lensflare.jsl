#include frag.jsl
#include math.jsl

uniform float coreTightness;
uniform float streakIntensity;
uniform float glowWidth;

void main() {
  vec2 uvp = 2.0 * uv - 1.0;
  float radius = length(uvp);
  float alpha = 0.0;
  alpha += 1.00 * exp(-sqrt(coreTightness * radius));
  alpha += glowWidth * exp(-6.0 * radius);
  alpha += streakIntensity * exp(-64.0 * max(0.0, abs(uvp.y) - 0.008)) * exp(-pow2(2.5 * radius));
  RETURN(vec4(alpha));
}
