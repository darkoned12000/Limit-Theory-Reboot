#include frag.jsl
#include lighting.jsl
#include math.jsl
#include noise.jsl
#include cube.jsl

uniform samplerCube source;
uniform sampler2D sampleBuffer;
uniform float angle;
uniform int samples;

void main() {
  vec2 uvp = uv;
  vec3 p = GetCubePosition(uvp, true);
  vec4 c = vec4(0.0);

  for (int i = 0; i < samples; ++i) {
    float u = float(i + 1) / float(samples + 1);
    vec3 samp = texture2DLod(sampleBuffer, vec2(u, 0.5), 0.0).xyz;
    samp = normalize(mix(p, samp, angle));
    samp *= sign(dot(samp, p));
    c += textureCubeLod(source, samp, 0.0);
  }

  RETURN(c / float(samples));
}
