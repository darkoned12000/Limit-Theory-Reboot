#include vert.jsl

layout(location=15) VERT_OUT vec3 normal;
layout(location=13) VERT_OUT vec3 position;
layout(location=6) VERT_OUT vec4 ndcPos;

layout(location=18) VERT_OUT vec3 vertposscaled;
layout(location=19) VERT_OUT vec3 origin;
layout(location=5) VERT_OUT vec3 scale;

void main() {
  VS_PROLOGUE;

  scale = vec3(length((WORLD * vec4(1, 0, 0, 0)).xyz),
               length((WORLD * vec4(0, 1, 0, 0)).xyz),
               length((WORLD * vec4(0, 0, 1, 0)).xyz));

  origin = (WORLD * vec4(0.0, 0.0, 0.0, 1.0)).xyz;

  gl_Position = WVP * vp;
  linearDepth = gl_Position.z;
  gl_Position.z = LogDepth(gl_Position.z, gl_Position.w);

  position = worldPos.xyz;
  ndcPos = gl_Position;

  normal = normalize((WORLDIT * vn).xyz);

  vertpos = vp.xyz;
  vertnormal = vn.xyz;
  vertposscaled = vertpos * scale;
}
