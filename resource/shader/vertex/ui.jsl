#include vert.jsl

uniform vec2 size;

layout(location=9) VERT_OUT float width;
layout(location=10) VERT_OUT float height;

void main() {
  uv = vertex_uv;
  vertpos = vertex_position;
  vertnormal = vertex_normal;
  vertcolor = vertex_color;
  gl_Position = PROJ * vec4(vertex_position, 1.);
  width = size.x;
  height = size.y;
}
