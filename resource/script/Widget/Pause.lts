# Modal-driven game pause.
#
# A single delta-based counter shared through one static:
#   Pause_State 1   -> a modal opened (increment)
#   Pause_State -1  -> a modal closed (decrement)
#   Pause_State 0   -> query (returns true while any modal is open)
#
# HUD.lts increments when a modal is added; Widget/Window.lts and
# Widget/GameMenu.lts decrement when their modals close; the app polls
# with 0 each frame and skips world simulation while true.

function Bool Pause_State (Int delta)
  static count 0
  count += delta
  if count < 0
    count = 0
  count > 0
