type ScrollFrameV
  Float scroll 0.0
  Float scrollTarget 0.0
  Float innerSize 0.0
  Float excess 0.0
  Bool dragging false
  Float dragOffset 0.0

  function Void PrePosition (Widget self)
    innerSize = self.minSize.y
    self.minSize.y = 0.0

  function Void PostPosition (Widget self)
    for it self.GetChildren it.HasMore it.Advance
      var widget it.Get
      widget.pos.y -= scroll
    excess = (Max 0.0 innerSize - self.size.y)

  function Void PreDraw (Widget self)
    ClipRegion_Push (Vec2 -100000.0 self.pos.y) (Vec2 200000.0 self.size.y)

  function Void PostDraw (Widget self)
    ClipRegion_Pop
    if excess > 0.0
      var t scroll / excess
      var z (Max 4.0 (0.5 * self.size.y * (self.size.y / innerSize)))
      var y (Mix self.TopRight.y self.BottomRight.y - z t)
      DrawPanel (Vec2 self.TopRight.x - 6.0 self.pos.y) (Vec2 6 self.size.y) Colors:Primary 0.5 0.25 0
      DrawPanel (Vec2 self.TopRight.x - 7.0 y) (Vec2 7 z) Colors:Primary 0.5 0.85 0

  function Void PreUpdate (Widget self)
    ClipRegion_Push (Vec2 -100000.0 self.pos.y) (Vec2 200000.0 self.size.y)

  function Void PostUpdate (Widget self)
    ClipRegion_Pop
    if self.focusKey
      if Key_PageDown.Pressed
        scrollTarget += self.size.y
      if Key_PageUp.Pressed
        scrollTarget -= self.size.y
      if Key_Home.Pressed
        scrollTarget = 0
      if Key_End.Pressed
        scrollTarget = excess

    if self.focusScroll
      scrollTarget -= 0.1 * self.size.y * Mouse_GetScrollDelta

    if excess > 0.0
      var c Cursor_Get
      var inBar (self.TopRight.x - 14.0 <= c.x && c.x <= self.TopRight.x)
      var inBarY (self.pos.y <= c.y && c.y <= self.BottomRight.y)
      var z (Max 4.0 (0.5 * self.size.y * (self.size.y / innerSize)))
      var t scroll / excess
      var y (Mix self.TopRight.y self.BottomRight.y - z t)
      if (! dragging)
        if inBar && inBarY && Mouse_LeftPressed
          dragging = true
          dragOffset = c.y - y
      else
        if Mouse_LeftDown
          var ty (Clamp (c.y - dragOffset) self.pos.y (self.BottomRight.y - z))
          scrollTarget = ((ty - self.pos.y) / (self.size.y - z)) * excess
        else
          dragging = false

    scrollTarget = (Clamp scrollTarget 0.0 excess)
    scroll = (Mix scroll scrollTarget 1.0 - (ExpDecay FrameTimer_Get 0.1))

type ScrollFrameH
