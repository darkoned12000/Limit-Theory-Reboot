type SpacerH
  Float size

  function Void PreDraw (Widget self)
    DrawPanel self.LeftCenter (Vec2 self.size.x 2) 0.2 1 0.5 4

  function Void PrePosition (Widget self)
    self.minSize.y = size

type SpacerV
  Float size

  function Void PreDraw (Widget self)
    DrawPanel self.TopCenter (Vec2 2 self.size.y) 0.2 1 0.5 4

  function Void PrePosition (Widget self)
    self.minSize.x = size
