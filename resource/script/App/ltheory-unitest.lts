# =============================================================================
#  ltheory-unitest — the GALAXY version
#  This app is the "learning lab" version of ltheory-main.lts. It builds the
#  full procedural galaxy the same way the revived old client (ltheory_app)
#  does, so you can play in a real multi-system universe and experiment with
#  the generation knobs. Run it side-by-side with ltheory-main (which builds
#  ONE bare system) to see the difference.
#  Run:        python3 configure.py run ltheory-unitest
#  Compare:    python3 configure.py run ltheory-main
#  Key difference from ltheory-main.lts:
#    main     uses  (Object_System (Vec3 15.012) seed)      -> 1 bare system
#    unitest  uses  (Object_Universe seed depth)            -> N connected
#                systems, all populated by Object/System:Init and linked by
#                wormholes (fly into one to jump between systems).
# =============================================================================

# -----------------------------------------------------------------------------
# Shared config loader (key:value, "#" comments, no spaces around ":").
# Re-parsed per call; call from Initialize() and cache (see below).
# -----------------------------------------------------------------------------
function String Config_Get (String key)
  var text (File_Read "resource/script/gameConfig.txt")
  var lines (SplitLines text)
  var klen (Length key)
  for i 0 i < lines.Size i.++
    var line (lines.Get i)
    if (Substring line 0 1) != "#"
      if (Contains line key)
        if (Contains line ":")
          var llen (Length line)
          var vstart (klen + 1)
          var vlen (llen - vstart)
          return (Substring line vstart vlen)
  ""

type Node
  Float energy
  Float v

type LoadingScreen
  Float time 0
  (Array Node) nodes (Array Node)

  function Void Create (Widget self)
    for i 0 i < 512 i.++
      var node (Node 0 0)
      if (i == 0)
        node.energy = 0.0
      nodes += node

  function Void PostUpdate (Widget self)
    var factor (1.0 - (ExpDecay FrameTimer_Get 1.0))
    var elasticity 10.0
    var speed 1.0
    var damping 50.0

    for k 0 k < 5 k.++
      for i 0 i < nodes.Size i.++
        ref node1 (nodes.Get i)
        ref node2 (nodes.Get (Mod i + 1 nodes.Size))
        var delta (node1.energy - node2.energy)
        node2.v += elasticity * factor * delta
        node1.v -= elasticity * factor * delta

      for i 0 i < nodes.Size i.++
        ref node (nodes.Get i)
        node.energy += speed * factor * node.v
        node.v *= (ExpDecay FrameTimer_Get damping)

    if Float_Random < 0.01
      var base (Mod (Abs Int_Random) nodes.Size)
      var variance (Mix 0.05 0.4 Float_Random)
      for i 0 i < 64 i.++
        var t i / 64
        t = 2.0 * t - 1.0
        var e 0.5 * (Exp -1.0 * (Abs t / variance) ^ 1.0)
        var index (Mod base + i nodes.Size)
        ref node (nodes.Get index)
        node.energy += e

  function Void PreDraw (Widget self)
    DrawPanel self.pos self.size 0.04 1 1 0

  function Void PostDraw (Widget self)
    DrawText
      Font_Get "Gafata/Regular.ttf"
      FrameTimer_GetEMA10 * 1000.0 + " ms"
      self.pos + (Vec2 16 self.size.y - 16.0)
      10
      0.1
      1
      false

    Draw Icon/Cursors:Pointer Cursor_Get 12 2.0 * Colors:Primary 1.0

    var point (Glyph_Circle 0 1 1 1)
    var c1 (Vec3 0.1 0.5 1.0)
    var c2 (Vec3 0.5 0.7 1.0)

    var LOAD_TIME (ToFloat (Config_Get "loadTime"))
    if (LOAD_TIME < 0.5)
      LOAD_TIME = 18.0
    time += FrameTimer_Get
    var completion (Floor 100.0 * (Min 1.0 (time / LOAD_TIME)))

    var font Fonts:Default

    DrawText
      font
      "[ LOADING  //  " + completion + "% ]"
      self.Center
      20
      0.3
      1
      true

    DrawText
      Fonts:Heading
      "LIMIT THEORY - REBOOT"
      self.size * (Vec2 0.5 1.0) - (Vec2 0 64)
      72
      0.1
      1
      true

    for i 0 i < nodes.Size i.++
      var t i / nodes.Size
      ref node (nodes.Get i)
      var angle 2Pi * t
      var dir (Vec2 angle.Cos angle.Sin)
      var p1 self.Center + dir * 128
      var mult 1.0 + (ExpDecay (Length Cursor_Get - p1) 64.0)
      var h 2.0 * node.energy
      h *= mult
      var c 8.0 * (Abs node.v) * (Mix c1 c2 (Abs 2.0 * t - 1.0))
      var p2 self.Center + dir * (256.0 + 128.0 * h)
      Draw point p1 8 c 1.0
      Draw point p2 16 c 1.0
      Draw (Glyph_LineFade p1 p2 1 1) 0 1 c1 0.05

type App
  Interface ui
  Interface gameView
  Interface loadingUi
  Camera camera
  Player player
  Object root
  Widget desktop Widget
  Bool desktopVisible false
  Widget debugWidget Widget
  Bool debugVisible false

  function Void Initialize ()
    camera = Camera_Create
    camera.Push
    camera.SetRelativePos (Vec3 0 40 160)
    camera.SetRelativeLookAt (Vec3 0 0 0)

    ui = (Interface_Create "UI")
    gameView = (Interface_Create "Game View")
    loadingUi = (Interface_Create "Loading")
    loadingUi.Add (Custom Widget LoadingScreen)

    # =====================================================================
    #  LEVEL-SETUP KNOBS — edit these, save, and re-run to experiment.
    #  Everything below is the full "make a level" recipe, step by step.
    # =====================================================================
    # ONE number seeds the whole galaxy. Same seed, same galaxy, every run.
    var universeSeed (ToInt (Config_Get "seed"))
    # galaxy depth: 0 -> ~6 systems, 1 -> ~36 systems (demo), 2 -> ~216 systems
    var galaxyDepth 1
    # How far the player starts from the spawn object.
    var spawnOffset (Vec3 20000 0 0)
    var playerCredits (ToInt (Config_Get "playerCredits"))
    var shipHull (ToInt (Config_Get "shipHull"))

    # STEP 1 — BUILD THE GALAXY
    # Object_Universe(seed, depth) makes the WHOLE galaxy in one call:
    #   Universe -> Region -> (sub-Region...) -> System
    # Every System is then populated by the Object/System:Init script
    # (planet, stations, warp rails, patrols, pirates, AI players) and linked
    # to its neighbors by wormholes. This is the call the old client made
    # (ltheory_app: Object_Universe(98080, 1)) and our scripted app never did.
    root = (Object_Universe universeSeed galaxyDepth)

    # STEP 2 — WALK DOWN TO A SYSTEM
    # The universe is a containment tree (Universe -> Region -> System).
    # We follow the FIRST interior branch until we reach an object whose
    # type string is "System" (engine GetType -> ObjectType_String[]).
    # Try changing galaxyDepth to 2: the walk handles any depth automatically.
    while (root.GetType != "System")
      var it root.GetInteriorObjects
      if it.HasMore
        root = it.Get
      else
        break

    # STEP 3 — PICK A SPAWN POINT
    # The old client drops the player next to the first "Station" it can find
    # (stations have docks, markets, missions). We fall back to a planet, then
    # to a fixed position.
    # Object type strings (ObjectType_String[]): "Station", "Planet", "Zone",
    # "System", "Region", "Universe", "Wormhole", "Colony", ...
    var spawn Object
    for it root.GetInteriorObjects it.HasMore it.Advance
      var o it.Get
      if (o.GetType == "Station")
        spawn = o
        break
    if spawn.IsNull
      for it root.GetInteriorObjects it.HasMore it.Advance
        var o it.Get
        if (o.GetType == "Planet")
          spawn = o
          break

    # STEP 4 — CREATE THE PLAYER SHIP
    # Item_ShipType(hull value, seed...) -> Instantiate makes a fresh ship.
    var shipType (Item_ShipType shipHull 55 1 1 1)
    var ship shipType.Instantiate
    if spawn.IsNotNull
      ship.SetPos (spawn.GetPos + spawnOffset)
    else
      ship.SetPos (Vec3 0 250000 0)
    var weapon (Item_WeaponType 46)
    while (ship.Plug weapon) 0
    root.AddInterior ship

    # STEP 5 — MAKE THE PLAYER
    player = Player_Human
    player.AddCredits playerCredits
    player.AddAsset ship
    player.Pilot ship
    player.SetName "SuperSpaceSquirrel"

    # WHERE'S THE REST OF THE CONTENT?
    # Each system already contains its own AI (players, patrols, pirates),
    # stations, and rails — added by resource/script/Object/System.lts during
    # Object_Universe. To tweak a system's population, edit the knobs at the
    # top of System.lts:
    #   planetCount / playerCount / zoneCount  (lines ~11-13)
    #   patrol / pirate counts                 (lines ~172, 180)
    # To make more systems or link them differently, edit the depth above or
    # the region knobs in the engine (docs/universe-population.md section 10).

    ui.Add (Widget/HUD:Create player)
    Sound_PlayLooped "system/ambiance/089.wav" 0.05

    var loadingPasses Vector<Reference<RenderPassT>>
    loadingPasses.Append (RenderPass_Clear (Vec4 0.02 0.02 0.04 1.0))
    loadingPasses.Append (RenderPass_Interface loadingUi)
    gameView.Add (Widget_Rendered loadingPasses)

  function Void Update ()
    static started false
    static loadingElapsed 0.0

    var LOAD_TIME (ToFloat (Config_Get "loadTime"))
    if (LOAD_TIME < 0.5)
      LOAD_TIME = 18.0

    if (! started)
      loadingUi.Update
      gameView.Update
      gameView.Draw
      loadingElapsed += FrameTimer_Get
      if (loadingElapsed >= LOAD_TIME)
        var passes Vector<Reference<RenderPassT>>
        passes.Append (RenderPass_Clear (Vec4 0.0))
        passes.Append (RenderPass_Camera camera)
        passes.Append (RenderPass_SMAA)
        # Extra low-threshold bloom: the dust streaks (Object_DustFlecks) and
        # the nebula are pure additive and read as black without it. The
        # camera pass has its own bloom (128, 64); this second pass (64, 32)
        # is what the old client appended to make the galaxy glow.
        passes.Append (RenderPass_Bloom 64 32)
        passes.Append (RenderPass_Interface ui)
        passes.Append (RenderPass_PostFilter "post/dither.jsl")
        gameView.Clear
        gameView.Add (Widget_Rendered passes)
        started = true
      return

    var dt (Min 0.1 FrameTimer_Get)
    root.Update dt

    var ship player.GetPiloting
    for it root.GetInteriorObjects it.HasMore it.Advance
      var o it.Get
      if (o.GetType == "Planet")
        var toShip (ship.GetPos - o.GetPos)
        var dist (Length toShip)
        var minDist (o.GetScale.x * 1.1)
        if (dist < minDist)
          var normal (toShip / dist)
          ship.SetPos (o.GetPos + (minDist * normal))

    camera.SetTarget player.GetPiloting

    if Key_Y.Pressed
      var target Object
      for it player.GetPiloting.GetTargets it.HasMore it.Advance
        target = it.Get
      if target.IsNotNull
        target.Send (MessageStartUsing player.GetPiloting)

    if Key_U.Pressed
      var target Object
      for it player.GetPiloting.GetTargets it.HasMore it.Advance
        target = it.Get
      if target.IsNotNull
        target.Send (MessageStopUsing player.GetPiloting)

    # F3 Debug
    if Key_F3.Pressed
      debugVisible = debugVisible.!
      switch
        debugVisible
          debugWidget = (Widget/DebugScene:Create root)
          ui.Add debugWidget
        otherwise
          if debugWidget.IsNotNull
            debugWidget.Delete

    var container player.GetPiloting.GetContainer
    if Key_H.Down dt *= 20.0
    container.Update dt

    ui.Update
    gameView.Update
    gameView.Draw

function App Main ()
  var self App
  self
